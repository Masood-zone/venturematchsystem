# Keep credentials server-only. Preserve TiDB-required connection/TLS options.
DATABASE_URL="mysql://USERNAME:PASSWORD@HOST:4000/DATABASE"
# Generate using: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
# Exact browser origin. Use the actual HTTPS domain in production.
BETTER_AUTH_URL="http://localhost:3000"

# Server-side SMTP. Use port 587 with STARTTLS, or 465 with SMTP_SECURE=true.
# SMTP_SERVICE can replace SMTP_HOST for a Nodemailer provider preset.
# SMTP_PASS is accepted as a fallback for existing deployments.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="VentureMatch <noreply@example.com>"
VENTURE_EMAIL_DELIVERY="false"
