model venture_application {
  id String @id
  ventureId String
  applicantUserId String
  message String @db.Text
  profileSnapshot String @db.MediumText
  status venture_application_status @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  respondedAt DateTime?
  venture venture @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  applicant user @relation(fields: [applicantUserId], references: [id], onDelete: Cascade)

  @@unique([ventureId, applicantUserId])
  @@index([applicantUserId, status])
  @@index([ventureId, status])
}

enum venture_application_status {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}
