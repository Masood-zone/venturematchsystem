{
  "name": "venturematchsystem",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "venture:worker": "node --import ./scripts/register-server-only.mjs --import=tsx scripts/venture-worker.ts",
    "test:trials": "node --import ./scripts/register-server-only.mjs --import=tsx --test scripts/test-group-trials.ts",
    "test:venture-integration": "node --import ./scripts/register-server-only.mjs --import=tsx --test scripts/test-venture-integration.ts",
    "test:auth": "node --conditions=react-server --import=tsx --test scripts/test-auth.ts",
    "test:applications": "node --conditions=react-server --import=tsx --test scripts/test-applications.ts scripts/test-profile.ts",
    "test:dashboards": "node --conditions=react-server --import=tsx --test scripts/test-dashboards.ts",
    "db:census": "node --conditions=react-server --import=tsx scripts/catalogue-census.ts",
    "db:seed:onboarding": "node --conditions=react-server --import=tsx scripts/seed-onboarding.ts",
    "test:onboarding": "node --conditions=react-server --import=tsx --test scripts/test-onboarding.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.3",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.2.0",
    "@tanstack/react-query": "^5.107.1",
    "axios": "^1.21.0",
    "better-auth": "^1.7.18",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "dotenv": "^18.0.9",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.12.0"
}
